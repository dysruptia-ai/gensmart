{
  "name": "@gensmart/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "dotenv -e ../../.env -- node-pg-migrate --database-url-var=DATABASE_URL --migration-file-language=sql --migrations-dir=src/db/migrations up",
    "migrate:down": "dotenv -e ../../.env -- node-pg-migrate --database-url-var=DATABASE_URL --migration-file-language=sql --migrations-dir=src/db/migrations down",
    "seed": "tsx src/db/seeds/index.ts",
    "test:email": "dotenv -e ../../.env -- tsx --test src/services/email.test.ts src/services/email-contact.test.ts",
    "seed:test-users": "tsx src/db/seeds/test-users.seed.ts",
    "stripe:seed": "tsx src/db/seeds/stripe-products.ts",
    "lint": "eslint src",
    "check:wa-tokens": "dotenv -e ../../.env -- tsx src/scripts/check-whatsapp-token-expiry.ts",
    "encrypt:cf-secrets": "dotenv -e ../../.env -- tsx src/scripts/encrypt-custom-function-secrets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@gensmart/shared": "*",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "email-reply-parser": "^2.3.9",
    "express": "^5.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "mammoth": "^1.11.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "node-pg-migrate": "^7.0.0",
    "nodemailer": "10.0.13",
    "openai": "^6.25.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "qrcode": "^1.5.0",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "stripe": "^20.4.0",
    "svix": "^2.9.1",
    "undici": "^7.30.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.0",
    "@types/compression": "^1.7.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.0",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.0.0",
    "@types/qrcode": "^1.5.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.71.0"
  }
}
